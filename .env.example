# Copy to .env for local development (npm run start:dev).
PORT=3000

# postgres (default) or sqljs (in-memory, used by the tests)
DB_TYPE=postgres
DATABASE_URL=postgres://game:game@localhost:5432/game
# Auto-create tables from the entities. Convenient locally; use migrations in production.
DB_SYNC=true

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Used by `npm run seed` to create the admin and game-server accounts.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_SERVER_PASSWORD=change-me-server
